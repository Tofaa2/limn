#version 460
#include "common.glsl"
#include "liquid.glsl"

// One stage of a liquid's step, chosen by `mode`:
//   0  move every particle by its velocity and gravity (a first guess at
//      where it ends up) and give birth to this step's new ones;
//   1  sort the guesses into a grid, so neighbours can be found;
//   2  measure how crowded each particle is and how hard it must push;
//   3  push: move each guess apart from its neighbours, and keep it in
//      the box and out of obstacles;
//   4  work out the velocity that got each particle to its guess, drawn
//      a little toward its neighbours';
//   5  take the guess as the new position.
// Stages 2 and 3 are run a few times over.
layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform Push {
    LiquidRef liquid;
    LiquidParticles particles;
    LiquidCells counts;
    LiquidCells cells;
    uint mode;
    // Which of the two guesses is the one to read.
    uint flip;
} push;

const float PI_ = 3.14159265;

// The liquid's record, read a field at a time: copying all of it for
// every particle costs more than the step itself.
#define LIQUID push.liquid.data

uint hash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

float random(inout uint state) {
    state = hash(state);
    return float(state >> 8) / 16777216.0;
}

ivec3 cellOf(vec3 position) {
    return clamp(ivec3(position / LIQUID.h), ivec3(0), LIQUID.cells - 1);
}

uint cellIndex(ivec3 cell) {
    return uint(cell.x + LIQUID.cells.x * (cell.y + LIQUID.cells.y * cell.z));
}

vec3 guessOf(LiquidParticle particle, uint flip) {
    return flip == 0u ? particle.guess_a : particle.guess_b;
}

// Keeps a point inside the box and outside the obstacles.
vec3 contained(vec3 position) {
    for (uint i = 0u; i < LIQUID.sphere_count; i++) {
        vec3 away = position - LIQUID.spheres[i].xyz;
        float reach = LIQUID.spheres[i].w + LIQUID.radius;
        float distance_squared = dot(away, away);
        if (distance_squared < reach * reach && distance_squared > 1.0e-12) position = LIQUID.spheres[i].xyz + away * (reach / sqrt(distance_squared));
    }
    return clamp(position, vec3(LIQUID.radius), LIQUID.extent - vec3(LIQUID.radius));
}

void main() {

    uint index = gl_GlobalInvocationID.x;
    if (index >= LIQUID.live) return;

    if (push.mode == 0u) {
        LiquidParticle particle = push.particles.data[index];
        if (index >= LIQUID.live_before) {
            uint state = hash(index * 0x9e3779b9u + LIQUID.seed);
            particle.velocity = vec3(0.0);
            if (index < LIQUID.block_count) {
                // Part of the block the liquid starts as.
                uint column = index % LIQUID.block_nx;
                uint row = (index / LIQUID.block_nx) % LIQUID.block_nz;
                uint layer = index / (LIQUID.block_nx * LIQUID.block_nz);
                vec3 jitter = (vec3(random(state), random(state), random(state)) - 0.5) * 0.05;
                particle.position = LIQUID.block_origin + (vec3(column, layer, row) + 0.5 + jitter) * LIQUID.spacing;
            } else {
                // Poured from a source, a layer at a time: each layer a
                // disc of evenly spread particles across the jet, the
                // layers a particle's width apart, so that the jet
                // leaves its mouth as a solid stream.
                LiquidSource source = LIQUID.sources[0];
                uint which = 0u;
                for (uint i = 1u; i < LIQUID.source_count; i++) {
                    if (index >= LIQUID.source_start[i] && index < LIQUID.source_end[i]) {
                        source = LIQUID.sources[i];
                        which = i;
                    }
                }
                vec3 along = normalize(source.velocity + vec3(0.0, -1.0e-4, 0.0));
                vec3 side = normalize(cross(along, abs(along.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
                vec3 other = cross(along, side);
                uint per_layer = max(uint(source.layer), 1u);
                uint born = index - LIQUID.source_start[which];
                uint layer = born / per_layer;
                uint place = born % per_layer;
                float angle = float(place) * 2.39996323 + float(layer + LIQUID.seed % 64u) * 0.7;
                float reach = sqrt((float(place) + 0.5) / float(per_layer)) * max(source.radius - LIQUID.radius, 0.0);
                particle.position = source.position + (side * cos(angle) + other * sin(angle)) * reach + along * (LIQUID.source_lead[which] + float(layer) * LIQUID.spacing);
                particle.velocity = source.velocity;
            }
            particle.position = contained(particle.position);
        }
        particle.velocity += LIQUID.gravity * LIQUID.dt;
        // A breath of disorder: without it particles pressed flat against
        // a wall can stand there as a film, each resting on the one below.
        uint shake = hash(index * 0x85ebca6bu + LIQUID.seed);
        vec3 nudge = (vec3(random(shake), random(shake), random(shake)) - 0.5) * LIQUID.h * 0.004;
        particle.guess_a = contained(particle.position + particle.velocity * LIQUID.dt + nudge);
        particle.guess_b = particle.guess_a;
        particle.lambda = 0.0;
        push.particles.data[index] = particle;
        return;
    }

    if (push.mode == 1u) {
        uint cell = cellIndex(cellOf(push.particles.data[index].guess_a));
        uint slot = atomicAdd(push.counts.data[cell], 1u);
        if (slot < LIQUID.slots) push.cells.data[cell * LIQUID.slots + slot] = index;
        return;
    }

    if (push.mode == 5u) {
        // The guess becomes the position.
        push.particles.data[index].position = push.flip == 0u ? push.particles.data[index].guess_a : push.particles.data[index].guess_b;
        return;
    }

    // The other stages look at every neighbour within reach. Lengths are
    // in units of that reach from here on.
    // Of each particle only what the stage needs is read: its guess, and
    // for some stages one thing more.
    vec3 own = push.flip == 0u ? push.particles.data[index].guess_a : push.particles.data[index].guess_b;
    float own_lambda = push.particles.data[index].lambda;
    vec3 own_position = push.particles.data[index].position;
    ivec3 home = cellOf(own);
    float density = 0.0;
    vec3 gradient_sum = vec3(0.0);
    float gradient_squares = 0.0;
    vec3 correction = vec3(0.0);
    vec3 own_velocity = (own - own_position) / LIQUID.dt;
    vec3 drift = vec3(0.0);
    // Read once: the loop below runs for every neighbour, and what it
    // would read again each time cannot be assumed unchanged while the
    // stage also writes.
    float inverse_h = 1.0 / LIQUID.h;
    float inverse_dt = 1.0 / LIQUID.dt;
    float inverse_rest = 1.0 / LIQUID.rest_density;
    uint slots = LIQUID.slots;
    ivec3 grid = LIQUID.cells;
    uint mode = push.mode;
    bool first = push.flip == 0u;
    for (int z = -1; z <= 1; z++) for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
        ivec3 cell = home + ivec3(x, y, z);
        if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(cell, grid))) continue;
        uint base = uint(cell.x + grid.x * (cell.y + grid.y * cell.z));
        uint count = min(push.counts.data[base], slots);
        for (uint slot = 0u; slot < count; slot++) {
            uint other = push.cells.data[base * slots + slot];
            vec3 there = first ? push.particles.data[other].guess_a : push.particles.data[other].guess_b;
            vec3 apart = (own - there) * inverse_h;
            float q2 = dot(apart, apart);
            if (q2 >= 1.0) continue;
            float q = sqrt(q2);
            float w = 1.0 - q2;
            float weight = (315.0 / (64.0 * PI_)) * w * w * w;
            // The spiky kernel's slope: steep up close, so that crowded
            // particles are pushed apart firmly.
            vec3 slope = q > 1.0e-5 ? apart * (-(45.0 / PI_) * (1.0 - q) * (1.0 - q) / q) : vec3(0.0);
            if (mode == 2u) {
                density += weight;
                if (other != index) {
                    vec3 share = slope * inverse_rest;
                    gradient_sum += share;
                    gradient_squares += dot(share, share);
                }
            } else if (mode == 3u) {
                if (other != index) correction += (own_lambda + push.particles.data[other].lambda) * slope;
            } else if (other != index) {
                // Neighbours pull each other's speed together a little:
                // the liquid moves as a body, not as a swarm.
                drift += ((there - push.particles.data[other].position) * inverse_dt - own_velocity) * weight;
            }
        }
    }
    // A wall stands in for the liquid that would be behind it: without
    // that, particles beside a wall seem to have room, and the rest
    // squeezes them against it and up it.
    for (int axis = 0; axis < 3; axis++) for (int side = 0; side < 2; side++) {
        float gap = (side == 0 ? own[axis] : LIQUID.extent[axis] - own[axis]) / LIQUID.h;
        if (gap >= 1.0) continue;
        float near = 1.0 - max(gap, 0.0);
        vec3 inward = vec3(0.0);
        inward[axis] = side == 0 ? 1.0 : -1.0;
        vec3 share = -inward * near;
        if (push.mode == 2u) {
            density += 0.5 * LIQUID.rest_density * near * near;
            gradient_sum += share;
        } else if (push.mode == 3u) {
            correction += own_lambda * share * LIQUID.rest_density;
        }
    }
    if (push.mode == 2u) {
        // Only crowding counts: liquid with room to spare is left alone,
        // so its surface does not cling together.
        float crowding = max(density / LIQUID.rest_density - 1.0, 0.0);
        push.particles.data[index].lambda = -crowding / (gradient_squares + dot(gradient_sum, gradient_sum) + 0.05);
    } else if (push.mode == 3u) {
        vec3 moved = contained(own + correction / LIQUID.rest_density * LIQUID.h);
        if (push.flip == 0u) push.particles.data[index].guess_b = moved;
        else push.particles.data[index].guess_a = moved;
    } else {
        // Stage 4: the velocity is what got the particle to its guess.
        vec3 velocity = own_velocity + drift * (LIQUID.viscosity / LIQUID.rest_density);
        // Nothing crosses more than a cell in a step.
        float speed = length(velocity);
        float limit = LIQUID.h / LIQUID.dt;
        if (speed > limit) velocity *= limit / speed;
        push.particles.data[index].velocity = velocity * LIQUID.keep;
    }
}

#version 460
#include "common.glsl"
#include "particles.glsl"

// Advances one emitter's particles and gives birth to this frame's share.
layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform Push {
    FrameConstants frame;
    EmitterRef emitter;
    Particles particles;
    // Remembered positions for trails; unused when the emitter has none.
    TrailPoints trail;
} push;

uint hash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

float random(inout uint state) {
    state = hash(state);
    return float(state >> 8) / 16777216.0;
}

void main() {
    EmitterData emitter = push.emitter.data;
    uint index = gl_GlobalInvocationID.x;
    if (index >= emitter.capacity) return;
    float dt = push.frame.delta_time;
    Particle particle = push.particles.data[index];

    uint slot = (index + emitter.capacity - emitter.spawn_start) % emitter.capacity;
    if (slot < emitter.spawn_count) {
        uint state = hash(index * 0x9e3779b9u + emitter.seed);
        // A direction inside the cone around the emitter's axis.
        float cos_limit = cos(emitter.spread);
        float cos_theta = mix(1.0, cos_limit, random(state));
        float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
        float phi = 2.0 * PI * random(state);
        vec3 axis = normalize(emitter.direction);
        vec3 side = normalize(abs(axis.y) < 0.99 ? cross(axis, vec3(0.0, 1.0, 0.0)) : cross(axis, vec3(1.0, 0.0, 0.0)));
        vec3 other = cross(axis, side);
        vec3 direction = axis * cos_theta + (side * cos(phi) + other * sin(phi)) * sin_theta;
        // A point inside the emitter's sphere.
        vec3 offset = vec3(random(state), random(state), random(state)) * 2.0 - 1.0;
        offset *= emitter.radius * pow(random(state), 1.0 / 3.0) / max(length(offset), 1e-4);
        particle.velocity = direction * mix(emitter.speed.x, emitter.speed.y, random(state));
        particle.lifetime = mix(emitter.lifetime.x, emitter.lifetime.y, random(state));
        // Births are spread over the frame rather than all at its start.
        particle.age = dt * random(state);
        particle.position = emitter.position + offset + particle.velocity * particle.age;
        // A newborn's trail starts where it does.
        for (uint point = 0u; point < emitter.trail_count; point++)
            push.trail.data[index * emitter.trail_count + point] = vec4(particle.position, 0.0);
    } else if (particle.age < particle.lifetime) {
        if (emitter.trail_count != 0u) {
            // The trail moves with the scene, and takes in where the
            // particle is now when it is time to remember a point.
            if (any(notEqual(emitter.shift, vec3(0.0)))) {
                for (uint point = 0u; point < emitter.trail_count; point++)
                    push.trail.data[index * emitter.trail_count + point].xyz += emitter.shift;
            }
            if (emitter.trail_record != 0u)
                push.trail.data[index * emitter.trail_count + emitter.trail_head] = vec4(particle.position + emitter.shift, 0.0);
        }
        particle.velocity += emitter.gravity * dt;
        particle.velocity *= exp(-emitter.drag * dt);
        // Carried by a fluid: inside its box, take on the flow's velocity.
        if ((emitter.flags & EMITTER_FLUID) != 0u) {
            FluidRef fluid = emitter.fluid;
            vec3 uvw = (fluid.data.world_to_box * vec4(particle.position, 1.0)).xyz;
            if (all(greaterThan(uvw, vec3(0.0))) && all(lessThan(uvw, vec3(1.0)))) {
                ivec3 size = fluid.data.size;
                vec3 cells = sampleVolume(fluid.data.velocity_texture, fluid.data.sampler_linear, uvw, size, fluid.data.tiles_x).xyz;
                vec3 flow = (fluid.data.box_to_world * vec4(cells / vec3(size), 0.0)).xyz;
                particle.velocity = mix(flow, particle.velocity, exp(-emitter.follow * dt));
            }
        }
        vec3 next = particle.position + emitter.shift + particle.velocity * dt;
        // Bounce off what the camera saw last frame: the depth buffer is
        // the only description of the scene's surfaces the GPU has.
        if ((emitter.flags & EMITTER_COLLIDE) != 0u) {
            FrameConstants frame = push.frame;
            uint nearest = frame.sampler_nearest_clamp;
            vec4 clip = frame.prev_view_proj_unjittered * vec4(next, 1.0);
            vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
            if (clip.w > frame.near && all(greaterThan(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)))) {
                float depth = textureLod(TEX(emitter.collision_depth, nearest), uv, 0.0).r;
                float surface = linearDepth(depth, frame.near);
                // Behind the surface, but not so far that it is simply
                // passing behind an object.
                float behind = clip.w - surface;
                if (depth > 0.0 && behind > 0.0 && behind < 0.5 + length(particle.velocity) * dt * 2.0) {
                    vec2 texel = 1.0 / vec2(textureSize(TEX(emitter.collision_depth, nearest), 0));
                    vec3 here = worldPositionFromDepth(uv, depth, frame.inv_view_proj);
                    vec3 across = worldPositionFromDepth(uv + vec2(texel.x, 0.0), textureLod(TEX(emitter.collision_depth, nearest), uv + vec2(texel.x, 0.0), 0.0).r, frame.inv_view_proj);
                    vec3 down = worldPositionFromDepth(uv + vec2(0.0, texel.y), textureLod(TEX(emitter.collision_depth, nearest), uv + vec2(0.0, texel.y), 0.0).r, frame.inv_view_proj);
                    vec3 normal = normalize(cross(across - here, down - here));
                    if (dot(normal, frame.camera_position - here) < 0.0) normal = -normal;
                    if (dot(particle.velocity, normal) < 0.0)
                        particle.velocity = reflect(particle.velocity, normal) * emitter.bounce;
                    next = here + normal * 0.01 + particle.velocity * dt;
                }
            }
        }
        particle.position = next;
        particle.age += dt;
    }
    push.particles.data[index] = particle;
}

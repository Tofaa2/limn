#version 460
#extension GL_EXT_mesh_shader : require
#include "common.glsl"

layout(buffer_reference, scalar) readonly buffer MeshletList { uint data[]; };
layout(buffer_reference, scalar) readonly buffer MeshletCount { uint value; };

// Triangles per mesh shader group; larger meshlets take two.
const uint triangles_per_group = 64u;
// Listed meshlets per task shader group.
const uint meshlets_per_task = 32u;

struct MeshletTasks {
    // Per mesh shader group: meshlet reference << 1 | which half of its
    // triangles.
    uint entries[meshlets_per_task * 2u];
};

// Draws up to 64 triangles of one meshlet, one per invocation.
layout(local_size_x = 64) in;
layout(triangles, max_vertices = 192, max_primitives = 64) out;

#include "visibility_page.glsl"

layout(push_constant, scalar) uniform Push {
    FrameConstants frame;
    // 1 in a shadow pass whose translucent casters go into the tint pass.
    uint tinted;
    // Nonzero when `page` supplies the view.
    uint paged;
    mat4 view_proj;
    // LOD cross-fade, main camera pass only: LOD camera (xyz), error-to-pixels
    // scale (w), band width (1 for none) and near plane.
    vec4 lod;
    float lod_band;
    float lod_near;
    // Meshlet references written by cull.comp, and their count.
    MeshletList list;
    MeshletCount count;
    VisibilityPage page;
} push;


taskPayloadSharedEXT MeshletTasks tasks;

layout(location = 0) flat out uint out_id[];
layout(location = 1) flat out uint out_material[];
layout(location = 2) out vec2 out_uv[];
layout(location = 3) flat out vec2 out_fade[];

#include "visibility_vertex.glsl"

void main() {
    uint entry = tasks.entries[gl_WorkGroupID.x];
    uint ref_index = entry >> 1;
    uint first_triangle = (entry & 1u) * triangles_per_group;
    MeshletRef ref = push.frame.meshlet_refs.data[ref_index];
    Instance instance = push.frame.instances.data[ref.instance];
    Mesh mesh = push.frame.meshes.data[instance.mesh];
    Meshlet meshlet = push.frame.meshlets.data[ref.meshlet];
    uint triangles = min(meshlet.index_count / 3u - first_triangle, triangles_per_group);
    SetMeshOutputsEXT(triangles * 3u, triangles);
    uint triangle = gl_LocalInvocationIndex;
    if (triangle >= triangles) return;
    uint first_index = mesh.index_offset + meshlet.index_offset + (first_triangle + triangle) * 3u;
    for (uint corner = 0u; corner < 3u; corner++) {
        VisibilityVertex vertex = visibilityVertex(ref_index, push.frame.indices.data[first_index + corner]);
        uint slot = triangle * 3u + corner;
        gl_MeshVerticesEXT[slot].gl_Position = vertex.position;
        gl_MeshVerticesEXT[slot].gl_ClipDistance[0] = vertex.inside.x;
        gl_MeshVerticesEXT[slot].gl_ClipDistance[1] = vertex.inside.y;
        gl_MeshVerticesEXT[slot].gl_ClipDistance[2] = vertex.inside.z;
        gl_MeshVerticesEXT[slot].gl_ClipDistance[3] = vertex.inside.w;
        out_id[slot] = vertex.id;
        out_material[slot] = vertex.material;
        out_uv[slot] = vertex.uv;
        out_fade[slot] = vertex.fade;
    }
    gl_PrimitiveTriangleIndicesEXT[triangle] = uvec3(triangle * 3u, triangle * 3u + 1u, triangle * 3u + 2u);
    gl_MeshPrimitivesEXT[triangle].gl_PrimitiveID = int(first_triangle + triangle);
}

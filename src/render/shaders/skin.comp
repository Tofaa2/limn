#version 460
#include "common.glsl"

layout(local_size_x = 64) in;

layout(buffer_reference, scalar) buffer SkinnedVertices { Vertex data[]; };
layout(buffer_reference, scalar) readonly buffer SkinVertices { SkinVertex data[]; };
layout(buffer_reference, scalar) readonly buffer Joints { mat4 data[]; };

struct MorphDelta {
    vec3 position;
    vec3 normal;
    vec3 tangent;
};
layout(buffer_reference, scalar) readonly buffer MorphDeltas { MorphDelta data[]; };

struct SkinJob {
    uint source_offset;
    uint destination_offset;
    uint skin_offset;
    uint joint_offset;
    uint vertex_count;
    uint morph_offset;
    uint target_count;
    uint first_group;
    uint weights_offset;
    uint job_pad0;
    uint job_pad1;
    uint job_pad2;
};
layout(buffer_reference, scalar) readonly buffer SkinJobs { SkinJob data[]; };
layout(buffer_reference, scalar) readonly buffer GroupJobs { uint data[]; };
layout(buffer_reference, scalar) readonly buffer MorphWeights { float data[]; };

const uint GROUPS_PER_ROW = 1024u;

layout(push_constant, scalar) uniform Push {
    SkinnedVertices vertices;
    SkinVertices skin;
    Joints joints;
    MorphDeltas morph;
    SkinJobs jobs;
    GroupJobs group_jobs;
    MorphWeights weights;
    uint group_count;
} push;

void main() {
    uint group = gl_WorkGroupID.y * GROUPS_PER_ROW + gl_WorkGroupID.x;
    if (group >= push.group_count) return;
    SkinJob job = push.jobs.data[push.group_jobs.data[group]];
    uint index = (group - job.first_group) * 64u + gl_LocalInvocationID.x;
    if (index >= job.vertex_count) return;
    Vertex vertex = push.vertices.data[job.source_offset + index];
    vec3 normal = vertexNormal(vertex);
    vec4 tangent = vertexTangent(vertex);
    for (uint target = 0u; target < job.target_count; target++) {
        float weight = push.weights.data[job.weights_offset + target];
        if (weight == 0.0) continue;
        MorphDelta delta = push.morph.data[job.morph_offset + target * job.vertex_count + index];
        vertex.position += delta.position * weight;
        normal += delta.normal * weight;
        tangent.xyz += delta.tangent * weight;
    }
    SkinVertex influence = push.skin.data[job.skin_offset + index];
    mat4 blend =
        push.joints.data[job.joint_offset + influence.joints.x] * influence.weights.x +
        push.joints.data[job.joint_offset + influence.joints.y] * influence.weights.y +
        push.joints.data[job.joint_offset + influence.joints.z] * influence.weights.z +
        push.joints.data[job.joint_offset + influence.joints.w] * influence.weights.w;
    mat3 rotation = mat3(blend);
    vertex.position = (blend * vec4(vertex.position, 1.0)).xyz;
    vertex.normal = packDirection(rotation * normal);
    vertex.tangent = packTangent(vec4(rotation * tangent.xyz, tangent.w));
    push.vertices.data[job.destination_offset + index] = vertex;
}

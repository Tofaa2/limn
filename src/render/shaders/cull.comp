#version 460
#include "common.glsl"
#include "cull_view.glsl"

layout(local_size_x = 64) in;

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(buffer_reference, scalar) writeonly buffer DrawCommands { DrawCommand data[]; };
layout(buffer_reference, scalar) writeonly buffer DrawLists { uint data[]; };
struct MeshDraw {
    uint x;
    uint y;
    uint z;
    uint pad;
};
layout(buffer_reference, scalar) buffer MeshDraws { MeshDraw data[2]; };
const uint meshlets_per_task = 32u;
layout(buffer_reference, scalar) buffer DrawCounts { uint data[]; };
layout(buffer_reference, scalar) buffer Visibility { uint data[]; };
layout(buffer_reference, scalar) readonly buffer MeshletBounds { vec4 data[]; };
layout(buffer_reference, scalar) buffer InstanceSeen { uint data[]; };
layout(buffer_reference, scalar) readonly buffer Candidates { uint data[]; };

layout(push_constant, scalar) uniform Push {
    FrameConstants frame;
    CullView view;
    DrawCommands commands;
    DrawCounts counts;
    Visibility visibility;
    uint ref_count;
    uint bucket_capacity;
    uint phase;
    uint hiz_texture;
    vec2 hiz_size;
    MeshletBounds skin_bounds;
    InstanceSeen seen;
    uint mark_seen;
    uint entity_refs;
    Candidates candidates;
    CullDispatch dispatch;
    InstanceVisibility instance_visibility;
    uint entity_instances;
    uint masked_capacity;
    uint seen_total;
    uint mesh_lists;
    MeshDraws mesh_draws;
    DrawLists lists;
} push;

void markSeen(uint instance) {
    if (push.mark_seen == 0u) return;
    if (atomicExchange(push.seen.data[instance], 1u) == 0u) atomicAdd(push.seen.data[push.seen_total], 1u);
}

#include "cull_occlusion.glsl"

bool shadowUnseen(vec3 center, float radius) {
    radius += push.view.receiver_margin;
    vec3 travel = push.view.light_travel;
    float from = 0.0;
    float to = 1.0e30;
    for (uint i = 0u; i < 6u; i++) {
        vec4 plane = push.view.receiver_planes[i];
        float start = dot(plane.xyz, center) + plane.w + radius;
        float change = dot(plane.xyz, travel);
        if (abs(change) < 1.0e-9) {
            if (start < 0.0) return true;
            continue;
        }
        float crossing = -start / change;
        if (change > 0.0) from = max(from, crossing);
        else to = min(to, crossing);
        if (from > to) return true;
    }
    if (push.view.receiver_culling < 2u) return false;
    vec3 a = (push.view.receiver_view * vec4(center + travel * from, 1.0)).xyz;
    vec3 b = (push.view.receiver_view * vec4(center + travel * to, 1.0)).xyz;
    a.z = -a.z;
    b.z = -b.z;
    vec4 box_a;
    vec4 box_b;
    if (!projectSphere(a, radius, push.view.receiver_near, push.view.receiver_p00, push.view.receiver_p11, box_a)) return false;
    if (!projectSphere(b, radius, push.view.receiver_near, push.view.receiver_p00, push.view.receiver_p11, box_b)) return false;
    vec2 uv_min = clamp(min(min(box_a.xy, box_a.zw), min(box_b.xy, box_b.zw)), 0.0, 1.0);
    vec2 uv_max = clamp(max(max(box_a.xy, box_a.zw), max(box_b.xy, box_b.zw)), 0.0, 1.0);
    float nearest = push.view.receiver_near / (min(a.z, b.z) - radius);
    return nearest < farthestDepth(uv_min, uv_max);
}

void main() {
    uint listed = gl_GlobalInvocationID.x;
    if (listed >= push.entity_refs + push.dispatch.count) return;
    uint ref_index = listed < push.entity_refs ? listed : push.candidates.data[listed - push.entity_refs];
    MeshletRef ref = push.frame.meshlet_refs.data[ref_index];
    Instance instance = push.frame.instances.data[ref.instance];
    Mesh mesh = push.frame.meshes.data[instance.mesh];
    Meshlet meshlet = push.frame.meshlets.data[ref.meshlet];
    Material material = push.frame.materials.data[instance.material];
    bool skinned = (instance.flags & INSTANCE_SKINNED) != 0u;
    bool blended = (material.flags & MATERIAL_BLEND) != 0u;
    if (blended && push.view.blended_casters == 0u) {
        markSeen(ref.instance);
        return;
    }

    bool fading = false;
    if (push.view.lod_scale > 0.0) {
        float scale = max(length(instance.transform[0].xyz), max(length(instance.transform[1].xyz), length(instance.transform[2].xyz)));
        vec3 mesh_center = skinned ? instance.bounding_sphere.xyz : (instance.transform * vec4(mesh.center, 1.0)).xyz;
        float mesh_radius = skinned ? instance.bounding_sphere.w : mesh.radius * scale;
        float distance_to_mesh = max(distance(push.view.lod_camera, mesh_center) - mesh_radius, push.view.near);
        float to_threshold = scale * push.view.lod_scale / distance_to_mesh;
        float band = max(push.view.lod_band, 1.0);
        float floor_error = instance.coarse_error;
        float own_error = max(meshlet.lod_error, floor_error);
        float parent_error = max(meshlet.parent_error, floor_error);
        if (floor_error > 0.0 && parent_error <= floor_error) return;
        bool at_floor = floor_error > 0.0 && own_error <= floor_error;
        float own = own_error * to_threshold;
        float coarser = parent_error * to_threshold;
        if (meshlet.self_sphere.w >= 0.0 && !skinned) {
            own = lodProjected(own_error, meshlet.self_sphere, instance.transform, scale, push.view.lod_camera, push.view.lod_scale, push.view.near);
            coarser = lodProjected(parent_error, meshlet.parent_sphere, instance.transform, scale, push.view.lod_camera, push.view.lod_scale, push.view.near);
        }
        if ((own > band && !at_floor) || coarser <= 1.0) return;
        fading = band > 1.0 && ((own > 1.0 && !at_floor) || coarser < band);
    } else if (instance.coarse_error > 0.0 ? max(meshlet.parent_error, instance.coarse_error) <= instance.coarse_error || meshlet.lod_error > instance.coarse_error : meshlet.lod_error > 0.0) {
        return;
    }
    bool was_visible = push.phase != PHASE_SINGLE && push.visibility.data[ref_index] != 0u;
    if (was_visible && push.phase == PHASE_LATE && ref.instance >= push.entity_instances)
        was_visible = (push.instance_visibility.data[ref.instance - push.entity_instances] & 2u) != 0u;
    if (push.phase == PHASE_EARLY && !was_visible) return;

    vec3 center;
    float radius;
    bool own_bounds = skinned && instance.bounds_offset != INVALID_ID;
    vec4 deformed = push.skin_bounds.data[own_bounds ? instance.bounds_offset + (ref.meshlet - mesh.meshlet_offset) : 0u];
    if (own_bounds) {
        center = (instance.transform * vec4(deformed.xyz, 1.0)).xyz;
        vec3 scale = vec3(length(instance.transform[0].xyz), length(instance.transform[1].xyz), length(instance.transform[2].xyz));
        radius = deformed.w * max(scale.x, max(scale.y, scale.z));
    } else if (skinned) {
        center = instance.bounding_sphere.xyz;
        radius = instance.bounding_sphere.w;
    } else {
        center = (instance.transform * vec4(meshlet.center, 1.0)).xyz;
        vec3 scale = vec3(length(instance.transform[0].xyz), length(instance.transform[1].xyz), length(instance.transform[2].xyz));
        radius = meshlet.radius * max(scale.x, max(scale.y, scale.z));
    }

    bool visible = true;
    if (push.view.min_radius > 0.0) {
        float whole = skinned ? instance.bounding_sphere.w : mesh.radius * max(length(instance.transform[0].xyz), max(length(instance.transform[1].xyz), length(instance.transform[2].xyz)));
        visible = whole >= push.view.min_radius;
    }
    for (uint i = 0u; i < push.view.plane_count; i++) {
        vec4 plane = push.view.planes[i];
        if (dot(plane.xyz, center) + plane.w < -radius) visible = false;
    }

    if (visible && push.view.receiver_culling != 0u && shadowUnseen(center, radius)) visible = false;

    bool two_sided = (material.flags & MATERIAL_DOUBLE_SIDED) != 0u;
    if (visible && push.view.cone_culling != 0u && !skinned && !two_sided && meshlet.cone_cutoff < 1.0) {
        vec3 axis = normalize(mat3(instance.transform) * meshlet.cone_axis);
        vec3 to_center = center - push.view.camera_position;
        if (dot(to_center, axis) >= meshlet.cone_cutoff * length(to_center) + radius) visible = false;
    }

    if (push.phase == PHASE_LATE) {
        if (visible && occluded(center, radius)) visible = false;
        push.visibility.data[ref_index] = visible ? 1u : 0u;
        if (visible) markSeen(ref.instance);
        if (was_visible) return;
    }
    if (!visible) return;
    if (push.phase == PHASE_SINGLE) markSeen(ref.instance);

    uint bucket = fading || (material.flags & (MATERIAL_ALPHA_TEST | MATERIAL_DOUBLE_SIDED | MATERIAL_BLEND)) != 0u ? 1u : 0u;
    uint slot = atomicAdd(push.counts.data[bucket], 1u);
    if (slot >= (bucket == 0u ? push.bucket_capacity : push.masked_capacity)) return;
    if (push.mesh_lists != 0u) {
        push.lists.data[bucket * push.bucket_capacity + slot] = ref_index;
        atomicMax(push.mesh_draws.data[bucket].x, (slot + meshlets_per_task) / meshlets_per_task);
        return;
    }
    DrawCommand command;
    command.index_count = meshlet.index_count;
    command.instance_count = 1u;
    command.first_index = mesh.index_offset + meshlet.index_offset;
    command.vertex_offset = 0;
    command.first_instance = ref_index;
    push.commands.data[bucket * push.bucket_capacity + slot] = command;
}

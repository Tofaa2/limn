#version 460
#include "common.glsl"
#include "vsm.glsl"

// Marks the virtual shadow map page each visible pixel falls in.
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant, scalar) uniform Push {
    FrameConstants frame;
    Vsm vsm;
    uint depth_texture;
    uint pad;
} push;

void main() {
    FrameConstants frame = push.frame;
    Vsm vsm = push.vsm;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(frame.resolution)))) return;
    float depth = texelFetch(TEX(push.depth_texture, frame.sampler_nearest_clamp), pixel, 0).r;
    if (depth <= 0.0) return;
    vec2 uv = (vec2(pixel) + 0.5) / frame.resolution;
    vec3 position = worldPositionFromDepth(uv, depth, frame.inv_view_proj);
    vec2 point = (vsm.light_view * vec4(position, 1.0)).xy;
    uint level = vsmLevel(vsm, point);
    ivec2 page;
    vec2 within;
    if (!vsmLocate(vsm, level, point, page, within)) return;
    vsm.requested.data[vsmSlot(level, page)] = vsm.frame;
}

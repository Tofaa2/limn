#version 460
#include "common.glsl"

// Builds per-froxel light and decal lists: one invocation per cluster tests
// each light's bounding sphere against the cluster's view-space box.
layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform Push {
    FrameConstants frame;
    // View depth at the near edge of slice 0 and the ratio between slices.
    float z_near;
    float z_ratio;
} push;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= CLUSTERS_X * CLUSTERS_Y * CLUSTERS_Z) return;
    FrameConstants frame = push.frame;
    uvec3 cell = uvec3(index % CLUSTERS_X, (index / CLUSTERS_X) % CLUSTERS_Y, index / (CLUSTERS_X * CLUSTERS_Y));

    float z0 = push.z_near * pow(push.z_ratio, float(cell.z));
    float z1 = z0 * push.z_ratio;
    // First slice extends to the camera, the last to infinity.
    if (cell.z == 0u) z0 = 0.0;
    if (cell.z == CLUSTERS_Z - 1u) z1 = 1e30;
    vec2 ndc0 = vec2(cell.xy) / vec2(CLUSTERS_X, CLUSTERS_Y) * 2.0 - 1.0;
    vec2 ndc1 = vec2(cell.xy + 1u) / vec2(CLUSTERS_X, CLUSTERS_Y) * 2.0 - 1.0;
    vec2 slope0 = (ndc0 - vec2(frame.proj[2][0], frame.proj[2][1]) * -1.0) / vec2(frame.proj[0][0], frame.proj[1][1]);
    vec2 slope1 = (ndc1 - vec2(frame.proj[2][0], frame.proj[2][1]) * -1.0) / vec2(frame.proj[0][0], frame.proj[1][1]);
    vec2 slope_min = min(slope0, slope1);
    vec2 slope_max = max(slope0, slope1);

    uint count = 0u;
    for (uint i = 0u; i < frame.light_count && count < CLUSTER_CAPACITY; i++) {
        Light light = frame.lights.data[i];
        vec3 center = (frame.view * vec4(light.position, 1.0)).xyz;
        float depth = -center.z;
        if ((light.flags & LIGHT_DIRECTIONAL) != 0u) {
            frame.clusters.data[index].lights[count] = i;
            count++;
            continue;
        }
        if (depth + light.range < z0 || depth - light.range > z1) continue;
        float z = clamp(depth, max(z0, 1e-4), max(min(z1, depth + light.range), 1e-4));
        vec3 closest = vec3(clamp(center.x, slope_min.x * z, slope_max.x * z), clamp(center.y, slope_min.y * z, slope_max.y * z), -z);
        // Conservative: the box grows with depth.
        float slack = light.range * max(max(abs(slope_min.x), abs(slope_max.x)), max(abs(slope_min.y), abs(slope_max.y)));
        vec3 delta = closest - center;
        if (dot(delta, delta) > (light.range + slack) * (light.range + slack)) continue;
        frame.clusters.data[index].lights[count] = i;
        count++;
    }
    frame.clusters.data[index].count = count;

    // Decals: same test on each box's bounding sphere.
    uint masks[CLUSTER_DECAL_WORDS];
    for (uint word = 0u; word < CLUSTER_DECAL_WORDS; word++) masks[word] = 0u;
    for (uint i = 0u; i < min(frame.decal_count, CLUSTER_DECAL_WORDS * 32u); i++) {
        vec4 bounds = frame.decals.data[i].bounds;
        vec3 center = (frame.view * vec4(bounds.xyz, 1.0)).xyz;
        float depth = -center.z;
        if (depth + bounds.w < z0 || depth - bounds.w > z1) continue;
        float z = clamp(depth, max(z0, 1e-4), max(min(z1, depth + bounds.w), 1e-4));
        vec3 closest = vec3(clamp(center.x, slope_min.x * z, slope_max.x * z), clamp(center.y, slope_min.y * z, slope_max.y * z), -z);
        float slack = bounds.w * max(max(abs(slope_min.x), abs(slope_max.x)), max(abs(slope_min.y), abs(slope_max.y)));
        vec3 delta = closest - center;
        if (dot(delta, delta) > (bounds.w + slack) * (bounds.w + slack)) continue;
        masks[i >> 5u] |= 1u << (i & 31u);
    }
    for (uint word = 0u; word < CLUSTER_DECAL_WORDS; word++) frame.clusters.data[index].decals[word] = masks[word];
}

#version 460
#include "common.glsl"

layout(local_size_x = 64) in;

struct BoundsJob {
    uint vertex_offset;
    uint meshlet_offset;
    uint meshlet_count;
    uint bounds_offset;
    uint first_group;
    uint job_pad0;
    uint job_pad1;
    uint job_pad2;
};
layout(buffer_reference, scalar) readonly buffer BoundsJobs { BoundsJob data[]; };
layout(buffer_reference, scalar) readonly buffer BoundsGroups { uint data[]; };
layout(buffer_reference, scalar) writeonly buffer MeshletBounds { vec4 data[]; };

const uint GROUPS_PER_ROW = 1024u;

layout(push_constant, scalar) uniform Push {
    Vertices vertices;
    Indices indices;
    Meshlets meshlets;
    MeshletBounds bounds;
    BoundsJobs jobs;
    BoundsGroups group_jobs;
    uint group_count;
} push;

void main() {
    uint group = gl_WorkGroupID.y * GROUPS_PER_ROW + gl_WorkGroupID.x;
    if (group >= push.group_count) return;
    BoundsJob job = push.jobs.data[push.group_jobs.data[group]];
    uint index = (group - job.first_group) * 64u + gl_LocalInvocationID.x;
    if (index >= job.meshlet_count) return;
    Meshlet meshlet = push.meshlets.data[job.meshlet_offset + index];
    vec3 low = vec3(1e30);
    vec3 high = vec3(-1e30);
    for (uint corner = 0u; corner < meshlet.index_count; corner++) {
        vec3 position = push.vertices.data[job.vertex_offset + push.indices.data[meshlet.index_offset + corner]].position;
        low = min(low, position);
        high = max(high, position);
    }
    vec3 center = (low + high) * 0.5;
    float reach = 0.0;
    for (uint corner = 0u; corner < meshlet.index_count; corner++) {
        vec3 position = push.vertices.data[job.vertex_offset + push.indices.data[meshlet.index_offset + corner]].position;
        vec3 offset = position - center;
        reach = max(reach, dot(offset, offset));
    }
    push.bounds.data[job.bounds_offset + index] = vec4(center, sqrt(reach));
}

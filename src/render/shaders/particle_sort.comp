#version 460
#include "common.glsl"
#include "particles.glsl"

layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform Push {
    ParticleOrder order;
    uint count;
    uint run;
    uint stride;
} push;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint partner = index ^ push.stride;
    if (partner <= index || partner >= push.count) return;
    SortEntry a = push.order.data[index];
    SortEntry b = push.order.data[partner];
    bool ascending = (index & push.run) == 0u;
    if ((a.key > b.key) == ascending) {
        push.order.data[index] = b;
        push.order.data[partner] = a;
    }
}
